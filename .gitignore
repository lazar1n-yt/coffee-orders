# ---- Node ----
node_modules/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
.pnpm-store/

# ---- Build output ----
dist/
build/
out/
.next/
.cache/
.parcel-cache/
.vite/

# ---- Coverage / test artefacts ----
coverage/
.nyc_output/
*.lcov

# ---- Env & secrets ----
.env
.env.*
!.env.example

# ---- Backend uploads (runtime, keep folder) ----
backend/uploads/*
!backend/uploads/.gitkeep

# ---- Prisma generated client (regenerated by `prisma generate`) ----
backend/node_modules/.prisma/

# ---- IDE / OS ----
.vscode/
!.vscode/settings.example.json
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# ---- Python (генератори звітів) ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- Docker volumes ----
postgres-data/

# ---- Logs ----
*.log
logs/

# ---- Артефакти звітів (тільки в корені) ----
/*.docx
/*.py

