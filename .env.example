# =====================================================================
#  Coffee Orders · приклад змінних середовища для повного стеку
#  Скопіюйте цей файл як `.env` і відредагуйте значення.
# =====================================================================

# --- PostgreSQL ---
POSTGRES_USER=coffee
POSTGRES_PASSWORD=coffee
POSTGRES_DB=coffee_orders

# --- Backend (api) ---
API_PORT=4000
JWT_ACCESS_SECRET=replace-me-with-strong-random-string
JWT_REFRESH_SECRET=replace-me-with-another-strong-random-string
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
CORS_ORIGIN=http://localhost:8080
PUBLIC_FILES_BASE_URL=http://localhost:4000/files

# SMTP (опційно — для email-сповіщень)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Coffee Orders <noreply@example.com>

# --- Frontend (web) ---
WEB_PORT=8080
VITE_API_BASE_URL=http://localhost:4000/api
